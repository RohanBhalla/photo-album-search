{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": { "english_stem": { "type": "stemmer", "language": "english" } },
      "analyzer": {
        "label_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "english_stem"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "objectKey":        { "type": "keyword" },
      "bucket":           { "type": "keyword" },
      "createdTimestamp": { "type": "date", "format": "strict_date_hour_minute_second||strict_date_optional_time" },
      "labels": {
        "type": "text",
        "analyzer": "label_analyzer",
        "fields": { "raw": { "type": "keyword" } }
      }
    }
  }
}
